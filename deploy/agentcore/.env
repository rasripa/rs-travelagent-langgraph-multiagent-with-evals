# Generated by deploy/agentcore/deploy.py
# Authorization is IAM/SigV4, so there are NO secrets in this file.
#   source deploy/agentcore/.env

# This file is for LOCAL CLIENTS (invoke.py, seed_memory.py, the
# frontend proxy, demo.py) -- not for the deployed runtimes, which
# carry only bootstrap settings and read the rest from Parameter
# Store at use time.
#
# Note the resolution order: an exported variable BEATS the store. So
# while these exports are sourced, a local process is pinned to the
# values below. That is what you want for a client talking to a known
# deployment -- but it also means that to see a put-parameter take
# effect locally you must unset the matching variable first:
#   unset TRAVEL_MODEL_ID TRAVEL_GATEWAY_URL
# The runtimes in AWS are unaffected: they never had these set.

export TRAVEL_RUN_MODE=agentcore
export AWS_REGION=us-west-2
export TRAVEL_CONFIG_SOURCE=ssm
export TRAVEL_CONFIG_PREFIX=/travel-demo
export TRAVEL_GATEWAY_URL=https://travel-demo-gateway-ehcezfksij.gateway.bedrock-agentcore.us-west-2.amazonaws.com/mcp
export TRAVEL_GATEWAY_ARN=arn:aws:bedrock-agentcore:us-west-2:588792541783:gateway/travel-demo-gateway-ehcezfksij

export JOURNEY_PLANNER_A2A_URL=https://bedrock-agentcore.us-west-2.amazonaws.com/runtimes/arn%3Aaws%3Abedrock-agentcore%3Aus-west-2%3A588792541783%3Aruntime%2Ftravel_demo_journey_planner-Gju3UN5szP/invocations/
export JOURNEY_SUPPORT_A2A_URL=https://bedrock-agentcore.us-west-2.amazonaws.com/runtimes/arn%3Aaws%3Abedrock-agentcore%3Aus-west-2%3A588792541783%3Aruntime%2Ftravel_demo_journey_support-15rZyfBRst/invocations/
export POLICY_ADVISOR_A2A_URL=https://bedrock-agentcore.us-west-2.amazonaws.com/runtimes/arn%3Aaws%3Abedrock-agentcore%3Aus-west-2%3A588792541783%3Aruntime%2Ftravel_demo_policy_advisor-b9nXrc317T/invocations/

export TRAVEL_ORCHESTRATOR_ARN=arn:aws:bedrock-agentcore:us-west-2:588792541783:runtime/travel_demo_train_travel_agent-7YiEUtH09X
export TRAVEL_KB_ID=CVTMAPQI1P
export TRAVEL_MEMORY_ID=travel_demo_memory-lYIVARH95l

# Observability: traces land on the CloudWatch GenAI Observability page.
# Each runtime already carries these; set them locally only if you want
# a local agent to export traces too.
# export AGENT_OBSERVABILITY_ENABLED=true

# Per-agent execution roles -- these ARNs are the Cedar principals.
# journey_planner: arn:aws:iam::588792541783:role/travel-demo-journey-planner-role
# journey_support: arn:aws:iam::588792541783:role/travel-demo-journey-support-role
# policy_advisor: arn:aws:iam::588792541783:role/travel-demo-policy-advisor-role
# train_travel_agent: arn:aws:iam::588792541783:role/travel-demo-orchestrator-role
